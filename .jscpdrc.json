{
  "$schema": "./node_modules/jscpd/schemas/jscpd-schema.json",
  "threshold": 5,
  "minTokens": 70,
  "minLines": 8,
  "reporters": ["console", "html"],
  "output": "./reports/jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.stryker-tmp/**",
    "**/*.test.ts",
    "e2e/**",
    "shared/types.ts",
    "server/db/schema.sql"
  ],
  "format": ["typescript", "vue"],
  "absolute": false,
  "gitignore": true
}
