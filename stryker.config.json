{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["progress", "clear-text", "html"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "server/services/tax/taxComputation.ts",
    "server/services/tax/credits.ts",
    "server/services/tax/scheduleE.ts",
    "server/services/tax/scheduleF.ts",
    "server/services/tax/form8829.ts",
    "server/services/tax/form8606.ts",
    "server/services/tax/form8889.ts",
    "server/services/tax/k1.ts",
    "server/services/tax/otherIncome.ts",
    "server/services/tax/deductions.ts"
  ],
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "related": false
  },
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 85
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "disableTypeChecks": "{test,src,server,shared}/**/*.{js,ts,jsx,tsx,html,vue}"
}
